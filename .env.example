# Public connection values. Use the dedicated hosted demo project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact browser origin for mutation requests if the hosting proxy changes the request URL.
AP_FOOD_APP_ORIGIN=
# Bootstrap only. Keep these out of the deployed runtime.
DATABASE_URL=
SUPABASE_SECRET_KEY=
AP_FOOD_DEMO_PROJECT_REF=
AP_FOOD_DEMO_PASSWORD=
# Optional. Enables the smoke test, which places and collects fictional orders.
AP_FOOD_HOSTED_SMOKE=0
# Set to supabase to use the hosted portals. The default is mock.
AP_FOOD_DATA_MODE=mock
# Optional local dev tool. Start Next on loopback when enabled.
AP_FOOD_LOCAL_TRAFFIC_LAB=0
