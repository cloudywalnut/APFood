# Supabase project (public values, safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://vymnnyyuiujmxxycqiod.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BAxTRs_A82FN_dFlgNUgzw_0UTd8FAm

# Server-only Supabase secret key. Needed at runtime for sign-in rate limits and account
# administration, and by the setup scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Exact browser origin for mutation requests if the hosting proxy changes the request URL.
AP_FOOD_APP_ORIGIN=http://localhost:3000

# Setup scripts only (migrations and seeding). Not needed by the deployed app.
DATABASE_URL=
AP_FOOD_DEMO_PROJECT_REF=vymnnyyuiujmxxycqiod
# First verified administrator for `npm run bootstrap:admin`. Refuses to run once an admin exists.
AP_FOOD_BOOTSTRAP_ADMIN_EMAIL=

# Optional. Enables `npm run test:hosted`, which places and collects fictional orders.
AP_FOOD_HOSTED_SMOKE=0

# Optional server-only Gemini ranking. FIF uses rules when unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Student chat: gemini or openai uses only that provider; auto tries Gemini then OpenAI.
FIF_CHAT_PROVIDER=gemini
# Optional server-only OpenAI credentials. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
